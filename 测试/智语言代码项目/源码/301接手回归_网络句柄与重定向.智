// 301 接手回归（第一轮）：网络句柄表与重定向校验
// ══════════════════════════════════════════════════════════════════════════
//   一、重复关闭必须幂等 ——曾把同一槽位两次放回空闲链，之后两个新资源共用一个句柄，
//       后者覆盖并关闭前者
//   二、在已关闭的连接上继续操作，之后网络模块必须仍可用 ——无效句柄曾在持有全局锁时
//       panic，锁中毒后进程内所有网络调用全部失败
//   三、响应重定向 的目标含回车/换行必须被拒绝 ——曾可注入任意响应头（响应拆分）
// 判据：解释 + 编译 双模一致且全部通过。
// ══════════════════════════════════════════════════════════════════════════
导入 网络
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 一、重复关闭幂等 =====")
    监听器甲 = 网络.监听(18311, {})
    监听器甲.关闭()
    监听器甲.关闭()
    监听器乙 = 网络.监听(18312, {})
    监听器丙 = 网络.监听(18313, {})
    检查("重复关闭后新建的两个监听器互不覆盖（乙端口）", 监听器乙.本地端口() == 18312)
    检查("重复关闭后新建的两个监听器互不覆盖（丙端口）", 监听器丙.本地端口() == 18313)

    输出("===== 二、已关闭资源上的操作不拖垮网络模块 =====")
    连接 = 网络.连接("127.0.0.1", 18312, {})
    连接.关闭()
    连接.关闭()
    写入被拒 = 假
    捕获:
        连接.写入("甲")
    异常:
        写入被拒 = 真
    结束
    检查("已关闭连接上写入抛出异常", 写入被拒 == 真)
    新连接 = 网络.连接("127.0.0.1", 18313, {})
    检查("此后网络模块仍可用（新连接远端端口）", 新连接.远端端口() == 18313)
    新连接.关闭()
    监听器乙.关闭()
    监听器丙.关闭()

    输出("===== 三、响应重定向拒绝控制字符 =====")
    注入被拒 = 假
    捕获:
        网络.响应重定向("/登录\回车\换行Set-Cookie: 会话=攻击者")
    异常:
        注入被拒 = 真
    结束
    检查("目标含回车换行被拒绝", 注入被拒 == 真)
    正常响应 = 网络.响应重定向("/首页?来源=甲")
    检查("正常目标仍返回 302", 正常响应.状态码() == 302)

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
