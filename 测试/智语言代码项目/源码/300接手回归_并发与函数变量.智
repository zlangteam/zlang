// 300 接手回归（第一轮）：并发、函数变量间接调用、整除溢出
// ══════════════════════════════════════════════════════════════════════════
// 每一节对应一处已修复的缺陷；判据：解释 + 编译 双模一致且全部通过。
//   一、函数变量调用「定义在 启动程序 之后的函数」——编译模式曾静默得到空值
//   二、最小整数 整除 -1 ——曾使进程崩溃
//   三、等待结果 之后再做带超时的 批量等待 ——曾得到空值
//   四、主任务阻塞在 多路监听 时，其他任务仍可注册并执行自己的 多路监听 ——曾互相卡死
//   五、两个任务的监听选项互不串台
// ══════════════════════════════════════════════════════════════════════════
导入 并发
导入 时间
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 一、函数变量间接调用 =====")
    函数甲 = 加倍
    检查("函数变量调用后定义的函数：加倍(3) = 6", 函数甲(3) == 6)
    函数乙 = 加一
    检查("函数变量调用最后定义的函数：加一(3) = 4", 函数乙(3) == 4)

    输出("===== 二、最小整数 整除 -1 =====")
    整数 最小 = -9223372036854775807 - 1
    整数 负一 = -1
    检查("最小整数 整除 -1 回绕为自身（不崩溃）", 最小 %% 负一 == 最小)
    检查("普通整除向下取整不受影响（-7 整除 2 = -4）", -7 %% 2 == -4)

    输出("===== 三、等待结果 后再超时批量等待 =====")
    任务甲 = 并发.启动任务(函数() 整数:
        返回 7
    结束)
    检查("等待结果 = 7", 任务甲.等待结果() == 7)
    再等 = 并发.批量等待([任务甲], 1000)
    检查("已等待过的任务，超时批量等待仍得 7", 再等[1] == 7)
    立即 = 并发.批量等待([任务甲], 0)
    检查("已完成的任务，零超时批量等待仍得 7", 立即[1] == 7)
    检查("再次 等待结果 仍得 7", 任务甲.等待结果() == 7)

    输出("===== 四、多路监听 阻塞期间其他任务可注册监听 =====")
    结果通道 = 并发.通道(1)
    工作任务 = 并发.启动任务(函数() 整数:
        时间.休眠(150)
        // 此时主任务正阻塞在 多路监听 上；这里注册并执行自己的监听不应被卡住
        并发.监听超时("工作超时", 10)
        并发.多路监听([])
        结果通道.发送("完成")
        返回 1
    结束)
    并发.监听通道("结果", 结果通道)
    并发.监听超时("主超时", 3000)
    主结果 = 并发.多路监听([])
    检查("主任务先等到工作任务的结果（而非自己的 3 秒超时）", 主结果.获取("来源") == "结果")
    工作任务.等待结果()

    输出("===== 五、不同任务的监听选项互不串台 =====")
    闲置通道 = 并发.通道(1)
    // 主任务先注册一个永不就绪的通道选项，暂不调用 多路监听
    并发.监听通道("主的通道", 闲置通道)
    旁路任务 = 并发.启动任务(函数() 文本:
        并发.监听超时("旁路超时", 20)
        旁路结果 = 并发.多路监听([])
        返回 旁路结果.获取("来源")
    结束)
    检查("旁路任务只看到自己的选项", 旁路任务.等待结果() == "旁路超时")
    并发.监听超时("主的超时", 20)
    主结果二 = 并发.多路监听([])
    检查("主任务的选项未被旁路任务吃掉", 主结果二.获取("来源") == "主的超时")
    闲置通道.关闭()
    结果通道.关闭()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束

加倍(整数 值) 整数:
    返回 值 * 2
结束

加一(整数 值) 整数:
    返回 值 + 1
结束
