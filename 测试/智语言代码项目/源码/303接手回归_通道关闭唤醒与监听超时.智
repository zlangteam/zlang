// 303 接手回归（第二轮）：通道关闭唤醒与多路监听超时
// ══════════════════════════════════════════════════════════════════════════
//   一、通道已满而阻塞的发送方，在通道被关闭后必须被唤醒（抛异常） ——曾永远卡住
//   二、关闭后缓冲区里的残留数据仍可接收
//   三、多路监听 的超时选项不再每次起一个睡满全程的计时线程 ——这里只验证语义不变
// 判据：解释 + 编译 双模一致且全部通过。
// ══════════════════════════════════════════════════════════════════════════
导入 并发
导入 时间
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 一、关闭通道唤醒阻塞的发送方 =====")
    满通道 = 并发.通道(1)
    满通道.发送("甲")
    发送任务 = 并发.启动任务(函数() 文本:
        捕获:
            满通道.发送("乙")
            返回 "送达"
        异常:
            返回 "被关闭唤醒"
        结束
        返回 "未知"
    结束)
    时间.休眠(150)
    满通道.关闭()
    等到 = 并发.批量等待([发送任务], 3000)
    检查("阻塞中的发送方在关闭后被唤醒并得到异常", 等到[1] == "被关闭唤醒")

    输出("===== 二、关闭后残留数据仍可接收 =====")
    检查("残留的「甲」仍可接收", 满通道.接收() == "甲")
    检查("排空后接收得到空值", 满通道.接收() == 空值)

    输出("===== 三、多路监听超时语义 =====")
    就绪通道 = 并发.通道(1)
    就绪通道.发送(1)
    整数 命中 = 0
    循环 次 = 1, 次 <= 500, 次 += 1:
        并发.监听通道("就绪", 就绪通道)
        并发.监听超时("长超时", 30000)
        本次 = 并发.多路监听([])
        如果 本次.获取("来源") == "就绪":
            命中 = 命中 + 1
        结束
    结束
    检查("500 次带长超时的监听都立即命中就绪通道", 命中 == 500)
    空通道 = 并发.通道(1)
    并发.监听通道("空", 空通道)
    并发.监听超时("短超时", 30)
    超时结果 = 并发.多路监听([])
    检查("无事件时由超时选项触发", 超时结果.获取("来源") == "短超时")
    并发.监听超时("零超时", 0)
    零结果 = 并发.多路监听([])
    检查("零超时立即触发", 零结果.获取("来源") == "零超时")
    就绪通道.关闭()
    空通道.关闭()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
