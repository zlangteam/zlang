// 302 接手回归（第二轮）：HTTP 服务生命周期与查询参数
// ══════════════════════════════════════════════════════════════════════════
//   一、端口被占用时 启动服务 必须抛异常 ——曾在后台线程绑定并忽略失败，返回「成功」的服务对象
//   二、服务关闭 之后端口必须释放、请求不再被处理 ——曾只清句柄表，后台线程与端口永远存活
//   三、查询参数先切分后解码 ——值里的 %26(&) / %3D(=) 曾被当成分隔符
//   四、连接.读取(字节数) 不切坏汉字 ——字节数落在多字节字符中间时曾产出替换字符（乱码）
// 判据：解释 + 编译 双模一致且全部通过。
// ══════════════════════════════════════════════════════════════════════════
导入 网络
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

处理请求(网络请求 请求) 网络响应:
    查询 = 请求.查询参数()
    甲值 = 查询.获取("甲")
    乙值 = 查询.获取("乙")
    回显 = "甲="
    如果 甲值 != 空值:
        回显 = 回显 + 甲值
    结束
    回显 = 回显 + ";乙="
    如果 乙值 != 空值:
        回显 = 回显 + 乙值
    结束
    返回 网络.响应成功(回显)
结束

启动程序():
    输出("===== 一、端口占用时启动服务抛异常 =====")
    占位 = 网络.监听(18321, {})
    启动被拒 = 假
    捕获:
        坏服务 = 网络.启动服务(18321, 处理请求, {})
    异常:
        启动被拒 = 真
    结束
    检查("端口被占用时 启动服务 抛出异常", 启动被拒 == 真)
    占位.关闭()

    输出("===== 二、查询参数先切分后解码 =====")
    服务 = 网络.启动服务(18322, 处理请求, {})
    响应 = 网络.获取("http://127.0.0.1:18322/回显?甲=1%262&乙=x%3Dy", {"超时": 5000})
    检查("值里的 %26 %3D 不被当成分隔符", 响应.内容() == "甲=1&2;乙=x=y")
    响应二 = 网络.获取("http://127.0.0.1:18322/回显?甲=你好&乙=2", {"超时": 5000})
    检查("中文查询值正常", 响应二.内容() == "甲=你好;乙=2")

    输出("===== 三、服务关闭后端口释放 =====")
    服务.关闭()
    服务.关闭()
    请求失败 = 假
    捕获:
        网络.获取("http://127.0.0.1:18322/回显?甲=1", {"超时": 2000})
    异常:
        请求失败 = 真
    结束
    检查("关闭后请求不再被处理", 请求失败 == 真)
    重启成功 = 真
    捕获:
        新服务 = 网络.启动服务(18322, 处理请求, {})
        响应三 = 网络.获取("http://127.0.0.1:18322/回显?甲=3", {"超时": 5000})
        重启成功 = 响应三.内容() == "甲=3;乙="
        新服务.关闭()
    异常:
        重启成功 = 假
    结束
    检查("关闭后可在同一端口重新启动", 重启成功 == 真)

    输出("===== 四、读取不切坏多字节字符 =====")
    监听器 = 网络.监听(18323, {})
    客户端 = 网络.连接("127.0.0.1", 18323, {})
    服务端连接 = 监听器.接受()
    服务端连接.设置超时(2000)
    客户端.写入("你好世界甲乙丙")
    客户端.关闭()
    累计 = ""
    捕获:
        循环 次 = 1, 次 <= 12, 次 += 1:
            片段 = 服务端连接.读取(4)
            如果 片段 == "":
                跳出
            结束
            累计 = 累计 + 片段
        结束
    异常:
        累计 = 累计 + "<异常>"
    结束
    检查("每次读 4 字节拼回原文无乱码", 累计 == "你好世界甲乙丙")
    服务端连接.关闭()
    监听器.关闭()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
